## Frontend (Vite) env vars

# -------------------------
# MODES
# -------------------------
# DEMO MODE (Browser): no credentials needed; the app will simulate wallet+pay.
# REAL MODE (World App): add Supabase + World Dev Portal credentials below.

# Prize pool receiver address (World Chain / EVM address)
VITE_PRIZE_POOL_ADDRESS=0x7aD48187A2a4f4bF8d5aE7aD7A9Dbb58B4e27046

# Celo prize pool receiver address (for cUSD/USDC payments on Celo)
VITE_CELO_PRIZE_POOL_ADDRESS=0xCf34005917b4d39AE97696D14e979F335CD6B2f0

# Comma-separated list of origins allowed to call the API. Used
# by the CORS middleware. Must include the production URL for
# browser POSTs to succeed (GETs work without CORS preflights;
# POSTs like /api/pay/free-entry do not). Example:
#   ALLOWED_ORIGINS=https://lasthumanstanding.thisyearnofear.com,http://localhost:5173
# ALLOWED_ORIGINS=

# Celo RPC endpoint for reading the prize pool balance (server-side).
# Defaults to https://forno.celo.org (Celo Foundation's public endpoint).
# Set a paid provider URL for higher rate limits, e.g.:
#   CELO_RPC=https://celo-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# CELO_RPC=

# -------------------------
# Cohort / game lifecycle
# -------------------------
# Pre-launch ends at this ISO timestamp (or when COHORT_SIZE is reached).
# Frontend reads this via /api/game/state.
# Cohort 1 pilot launch is provisional; confirm with /api/game/state before freeze.
GAME_LAUNCH_AT=2026-08-10T18:00:00Z
# Optional: when cohort 2 opens. Shown on the ended-phase handoff.
# Leave unset to show "Date TBA" + waitlist capture.
COHORT_2_LAUNCH_AT=2026-08-24T18:00:00Z
# Max reservations before pre-launch closes early.
# 25-person closed beta recommended for Jul 29 re-launch.
COHORT_SIZE=25
# Default first-N survivors per day (admin can override per round).
DAILY_SURVIVAL_CAP=25
# Default GPS radius (meters) for check-in proximity.
CHECKIN_RADIUS_M=100

# -------------------------
# Turing-test arena (agents)
# -------------------------
# Competing AI agents in the cohort. Off by default — schema + seat math
# ship now; flip AGENTS_ENABLED=true when ready to activate.
# AGENTS_ENABLED=false
# MAX_AGENT_RATIO=0.25
# MIN_AGENT_COUNT=5
# Hide World ID / Self badges in gameplay UI (verify still runs in background).
# SILENT_VERIFICATION=false

# Legacy lottery settings. Cohort 1 keeps LOTTERY_ENABLED=false and does not
# run a draw; these values apply only to a later lottery-enabled cohort.
# Lazy lottery draw gating. The draw is held until EITHER:
#   1) at least LOTTERY_MIN_CANDIDATES free entrants are signed up, OR
#   2) LOTTERY_MAX_DELAY_HOURS have passed since GAME_LAUNCH_AT.
# Whichever fires first triggers the deterministic draw. The /api/lottery/status
# response includes a `nextDrawAt` timestamp so the client can show a countdown.
# Lower to 5 for a 25-person beta; raise back to 10+ for a 50-person launch.
LOTTERY_MIN_CANDIDATES=5
LOTTERY_MAX_DELAY_HOURS=6

# -------------------------
# Admin tooling
# -------------------------
# Admin wallet address (connect this wallet to access /admin dashboard).
# Used together with ADMIN_TOKEN for backward compatibility.
ADMIN_ADDRESS=0xYourAdminWalletAddress
# Also set client-side so the admin UI knows which wallet is authorized:
VITE_ADMIN_ADDRESS=0xYourAdminWalletAddress

# Legacy: x-admin-token header for /api/admin/* endpoints.
# Still supported but ADMIN_ADDRESS (wallet-based) is preferred.
ADMIN_TOKEN=set-a-long-random-string-here

# -------------------------
# Supabase (Real mode: persistence + photo uploads)
# -------------------------
# Frontend uses anon key to upload using a signed upload URL from our backend.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# -------------------------
# World ID (optional, recommended)
# -------------------------
# Defaults are OFF so the app boots without Worldcoin credentials.
# Production deployments should set VITE_ENABLE_IDKIT=true together
# with a real VITE_WORLD_ID_APP_ID + server-side WORLD_ID_RP_ID /
# WORLD_ID_SIGNING_KEY (from the World Developer Portal) — otherwise
# users see the "World ID disabled" message and can only verify via
# Self Protocol.
#
# Required to make World ID register work end-to-end:
#   VITE_ENABLE_IDKIT=true         (client: render the IDKit widget)
#   VITE_MINI_APP_ID=app_xxx       (client: MiniKit / World App launch app)
#   VITE_WORLD_ID_APP_ID=app_xxx   (client: World ID app used by IDKit)
# These can be the same Developer Portal app. Set both explicitly if the
# Mini App and World ID integration were created as separate Portal apps.
#   WORLD_ID_RP_ID=rp_xxx          (server: signing identifier)
#   WORLD_ID_SIGNING_KEY=0x...     (server: secp256k1 signing key)
#   VITE_WORLD_ID_ACTION=last-human-standing
#
# When REQUIRE_WORLD_ID_FOR_VOTING=true, voting is gated on a verified
# PoH (World ID or Self nullifier on file). Recommended for anti-bot.
VITE_ENABLE_IDKIT=false
VITE_WORLD_ID_APP_ID=app_xxxxx
VITE_MINI_APP_ID=app_xxxxx
VITE_WORLD_ID_ACTION=last-human-standing
VITE_WORLD_ID_ENV=production
VITE_REQUIRE_WORLD_ID_FOR_VOTING=true

## Backend env vars (Express)

PORT=8787

# Public origin used for absolute URLs in share/snap/embed responses.
# Leave unset to infer from the incoming request (host + x-forwarded-proto).
# Set this if you're behind a CDN/proxy or running staging on a non-default host.
# PUBLIC_BASE_URL=https://lasthumanstanding.thisyearnofear.com

# Supabase admin (server-side DB writes + signed upload URLs)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET=checkins
# If your bucket is private, set this to true and we’ll use signed read URLs (recommended for production)
SUPABASE_BUCKET_PRIVATE=false

# World Developer Portal (payments + World ID verify)
WORLD_APP_ID=app_xxxxx
WORLD_DEV_PORTAL_API_KEY=YOUR_DEV_PORTAL_API_KEY

# World ID RP signature config (never expose signing key client-side)
WORLD_ID_APP_ID=app_xxxxx
WORLD_ID_ACTION=last-human-standing
WORLD_ID_RP_ID=rp_xxxxx
WORLD_ID_SIGNING_KEY=0xYOUR_SIGNING_KEY

# Enforce humanity verification for voting at the API layer. Default is ON
# (safe): only verified, admitted cohort members may cast verdict votes.
# Set explicitly to false ONLY for demos.
REQUIRE_WORLD_ID_FOR_VOTING=true

# -------------------------
# Cohort 1 pilot containment (see docs/COHORT1_PILOT.md)
# -------------------------
# Paid entry is DISABLED for the free, closed, verified-human pilot.
# Enable only once settlement is idempotent, receipt-verified, escrow-grade.
PAID_ENTRY_ENABLED=false
# Automatic winner payout is DISABLED: the pilot settles manually, in-kind
# (WLD on World Chain + cUSD on Celo) after the published appeal window.
AUTO_PAYOUT_ENABLED=false
# The referral-weighted lottery is NOT an admission boundary — it stays off;
# the admitted roster is operator-frozen instead.
LOTTERY_ENABLED=false
# Roster freeze: set ENTRY_CLOSED=true once the admitted list is final so no
# new participant can enter the open cohort.
# ENTRY_CLOSED=false
# Minimum verified roster required before Day 1 may auto-open. Below this,
# the scheduler holds (postponement) instead of starting a tiny game.
MIN_LAUNCH_PARTICIPANTS=8
# Verified-human requirement for entering and playing (default ON).
REQUIRE_HUMANITY_FOR_PLAY=true
# Infiltrator immunity + Day-4 jury revival are disabled for the pilot.
INFILTRATOR_ENABLED=false
REVIVAL_ENABLED=false
# Test-only routes (e.g. /api/test/session) are registered ONLY when this is
# true. Set it in the E2E harness environment, never in production.
# ENABLE_TEST_ROUTES=false

# -------------------------
# Push notifications (VAPID)
# -------------------------
# Generate these with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is also needed client-side; the server exposes it via GET /api/push/vapid-key
VAPID_PUBLIC_KEY=
VAPID_SECRET=
VAPID_EMAIL=admin@lasthumanstanding.thisyearnofear.com

# -------------------------
# Farcaster Mini App
# -------------------------
# Neynar API key for Farcaster Mini App features (optional, needed for
# managed signers and push notifications to Farcaster users).
# Get yours at https://dev.neynar.com
NEYNAR_API_KEY=set-on-server-only

# -------------------------
# Self Protocol (Celo proof-of-humanity, live)
# -------------------------
# Enable on client: VITE_ENABLE_SELF=true
# Enable on server: SELF_ENABLED=true
# Staging (Celo Sepolia + mock passports) for launch — flip
# SELF_MOCK_PASSPORT=false to verify real passports on Celo mainnet.
SELF_ENABLED=true
SELF_SCOPE=last-human-standing
SELF_VERIFY_ENDPOINT=https://lasthumanstanding.thisyearnofear.com/api/self/verify
SELF_MOCK_PASSPORT=true
SELF_EXCLUDED_COUNTRIES=IRN,PRK,RUS,SYR
SELF_MINIMUM_AGE=18
SELF_OFAC=true
VITE_ENABLE_SELF=true

# Use Celo Alfajores testnet for browser wallet flow (default: World Chain mainnet)
VITE_USE_CELO_TESTNET=false

# Hackathon campaign mode: free entry (no payment required)
# Enable for the weekend campaign, disable for real-money games
VITE_FREE_ENTRY_MODE=true
FREE_ENTRY_MODE=true

# -------------------------
# Audit / voting (cohort 1 pilot defaults)
# -------------------------
# Min weighted votes before a submission can finalize at day close (SQL default: 3).
# Verdicts auto-scale with the active roster: effective = clamp(ceil(roster *
# VOTE_QUORUM_RATIO), VOTE_QUORUM_MIN, VOTE_QUORUM), so small rooms still reach
# quorum. The existing low-activity fallback still applies on top.
VOTE_QUORUM=8
VOTE_QUORUM_LOW=5
VOTE_QUORUM_RATIO=0.3
VOTE_QUORUM_MIN=3
VOTE_ACTIVITY_WINDOW_MIN=60
VOTE_ACTIVITY_THRESHOLD=30
# Per-player daily vote goal shown on MissionBoard + audit nudge pushes.
VOTE_DAILY_GOAL=5
# Hours after a round opens before the audit-nudge push fires (once per day).
AUDIT_NUDGE_HOURS=2

# -------------------------
# Onchain voting (VoteRegistry on Celo mainnet)
# -------------------------
# Deployed VoteRegistry contract address. When set, every vote is enqueued
# for batch submission to Celo mainnet by the vote relayer.
# Leave unset for DB-only voting.
VOTE_REGISTRY_ADDRESS=

# Batch size for onchain vote submissions (default 1 = one tx per vote).
# Higher = fewer txs, lower gas cost. Tune for desired onchain volume.
VOTE_BATCH_SIZE=1

# How often the relayer polls the queue (ms). Default 15000.
VOTE_POLL_INTERVAL=15000

# Celo signing key for the vote relayer. Must have CELO for gas.
# The ARIA agent / prize pool wallet is the default relayer.
CELO_SIGNING_KEY=set-on-server-only

# -------------------------
# Player reachability (free lottery + round alerts)
# -------------------------
# Free entry requires wallet + notifications + contact (see ReachabilitySetup).
FREE_ENTRY_MODE=true

# Transactional email via Resend (round reminders, elimination notices).
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Last Human Standing <notify@lasthumanstanding.thisyearnofear.com>

# Telegram bot for DM alerts. Create via @BotFather, set webhook to:
# POST https://YOUR_DOMAIN/api/telegram/webhook?secret=YOUR_SECRET
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=LastHumanStandingBot
# TELEGRAM_WEBHOOK_SECRET=

# -------------------------
# Database migrations to apply
# -------------------------
# After deploying this version, run migration 006_vote_queue.sql in your
# Supabase SQL editor to create the crash-safe vote queue table and the
# atomic cast_vote / close_day functions:
#   supabase/migrations/006_vote_queue.sql

# -------------------------
# Sentry (optional — leave blank to disable)
# -------------------------
# Server-side DSN (shared between server + client in simple setups,
# or use separate project DSNs for finer-grained filtering).
# VITE_SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx
# SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx

# -------------------------
# Daytona SDK (E2E test harness)
# -------------------------
# Used by scripts/e2e-harness.mjs to spawn test sandboxes.
# Get your key at https://app.daytona.io/dashboard/keys
# DAYTONA_API_KEY=dtn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------------
# ElevenLabs Music (server-only)
# -------------------------
# Used to compose background soundtrack stems. Never expose as VITE_*.
# Generate / refresh cached loops: node scripts/generate-bgm.mjs
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
