## Frontend (Vite) env vars

# -------------------------
# MODES
# -------------------------
# DEMO MODE (Browser): no credentials needed; the app will simulate wallet+pay.
# REAL MODE (World App): add Supabase + World Dev Portal credentials below.

# Prize pool receiver address (World Chain / EVM address)
VITE_PRIZE_POOL_ADDRESS=0x7aD48187A2a4f4bF8d5aE7aD7A9Dbb58B4e27046

# Celo prize pool receiver address (for cUSD/USDC payments on Celo)
VITE_CELO_PRIZE_POOL_ADDRESS=0xCf34005917b4d39AE97696D14e979F335CD6B2f0

# Comma-separated list of origins allowed to call the API. Used
# by the CORS middleware. Must include the production URL for
# browser POSTs to succeed (GETs work without CORS preflights;
# POSTs like /api/pay/free-entry do not). Example:
#   ALLOWED_ORIGINS=https://lasthumanstanding.thisyearnofear.com,http://localhost:5173
# ALLOWED_ORIGINS=

# Celo RPC endpoint for reading the prize pool balance (server-side).
# Defaults to https://forno.celo.org (Celo Foundation's public endpoint).
# Set a paid provider URL for higher rate limits, e.g.:
#   CELO_RPC=https://celo-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# CELO_RPC=

# -------------------------
# Cohort / game lifecycle
# -------------------------
# Pre-launch ends at this ISO timestamp (or when COHORT_SIZE is reached).
# Frontend reads this via /api/game/state.
GAME_LAUNCH_AT=2026-06-13T14:00:00Z
# Max reservations before pre-launch closes early.
COHORT_SIZE=50
# Default first-N survivors per day (admin can override per round).
DAILY_SURVIVAL_CAP=25
# Default GPS radius (meters) for check-in proximity.
CHECKIN_RADIUS_M=100

# Lazy lottery draw gating. The draw is held until EITHER:
#   1) at least LOTTERY_MIN_CANDIDATES free entrants are signed up, OR
#   2) LOTTERY_MAX_DELAY_HOURS have passed since GAME_LAUNCH_AT.
# Whichever fires first triggers the deterministic draw. The /api/lottery/status
# response includes a `nextDrawAt` timestamp so the client can show a countdown.
LOTTERY_MIN_CANDIDATES=10
LOTTERY_MAX_DELAY_HOURS=6

# -------------------------
# Admin tooling
# -------------------------
# Admin wallet address (connect this wallet to access /admin dashboard).
# Used together with ADMIN_TOKEN for backward compatibility.
ADMIN_ADDRESS=0xYourAdminWalletAddress
# Also set client-side so the admin UI knows which wallet is authorized:
VITE_ADMIN_ADDRESS=0xYourAdminWalletAddress

# Legacy: x-admin-token header for /api/admin/* endpoints.
# Still supported but ADMIN_ADDRESS (wallet-based) is preferred.
ADMIN_TOKEN=set-a-long-random-string-here

# -------------------------
# Supabase (Real mode: persistence + photo uploads)
# -------------------------
# Frontend uses anon key to upload using a signed upload URL from our backend.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# -------------------------
# World ID (optional)
# -------------------------
VITE_ENABLE_IDKIT=false
VITE_WORLD_ID_APP_ID=app_xxxxx
VITE_WORLD_ID_ACTION=last-human-standing
VITE_WORLD_ID_ENV=production

# Voting gate (recommended for anti-bot posture)
VITE_REQUIRE_WORLD_ID_FOR_VOTING=false

## Backend env vars (Express)

PORT=8787

# Public origin used for absolute URLs in share/snap/embed responses.
# Leave unset to infer from the incoming request (host + x-forwarded-proto).
# Set this if you're behind a CDN/proxy or running staging on a non-default host.
# PUBLIC_BASE_URL=https://lasthumanstanding.thisyearnofear.com

# Supabase admin (server-side DB writes + signed upload URLs)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET=checkins
# If your bucket is private, set this to true and we’ll use signed read URLs (recommended for production)
SUPABASE_BUCKET_PRIVATE=false

# World Developer Portal (payments + World ID verify)
WORLD_APP_ID=app_xxxxx
WORLD_DEV_PORTAL_API_KEY=YOUR_DEV_PORTAL_API_KEY

# World ID RP signature config (never expose signing key client-side)
WORLD_ID_APP_ID=app_xxxxx
WORLD_ID_ACTION=last-human-standing
WORLD_ID_RP_ID=rp_xxxxx
WORLD_ID_SIGNING_KEY=0xYOUR_SIGNING_KEY

# Enforce World ID requirement for voting at the API layer (recommended when World ID is enabled)
REQUIRE_WORLD_ID_FOR_VOTING=false

# -------------------------
# Push notifications (VAPID)
# -------------------------
# Generate these with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is also needed client-side; the server exposes it via GET /api/push/vapid-key
VAPID_PUBLIC_KEY=
VAPID_SECRET=
VAPID_EMAIL=admin@lasthumanstanding.thisyearnofear.com

# -------------------------
# Farcaster Mini App
# -------------------------
# Neynar API key for Farcaster Mini App features (optional, needed for
# managed signers and push notifications to Farcaster users).
# Get yours at https://dev.neynar.com
NEYNAR_API_KEY=set-on-server-only

# -------------------------
# Self Protocol (Celo proof-of-humanity, live)
# -------------------------
# Enable on client: VITE_ENABLE_SELF=true
# Enable on server: SELF_ENABLED=true
# Staging (Celo Sepolia + mock passports) for launch — flip
# SELF_MOCK_PASSPORT=false to verify real passports on Celo mainnet.
SELF_ENABLED=true
SELF_SCOPE=last-human-standing
SELF_VERIFY_ENDPOINT=https://lasthumanstanding.thisyearnofear.com/api/self/verify
SELF_MOCK_PASSPORT=true
SELF_EXCLUDED_COUNTRIES=IRN,PRK,RUS,SYR
SELF_MINIMUM_AGE=18
SELF_OFAC=true
VITE_ENABLE_SELF=true

# Use Celo Alfajores testnet for browser wallet flow (default: World Chain mainnet)
VITE_USE_CELO_TESTNET=false

# Hackathon campaign mode: free entry (no payment required)
# Enable for the weekend campaign, disable for real-money games
VITE_FREE_ENTRY_MODE=true
FREE_ENTRY_MODE=true

# -------------------------
# Onchain voting (VoteRegistry on Celo mainnet)
# -------------------------
# Deployed VoteRegistry contract address. When set, every vote is enqueued
# for batch submission to Celo mainnet by the vote relayer.
# Leave unset for DB-only voting.
VOTE_REGISTRY_ADDRESS=

# Batch size for onchain vote submissions (default 1 = one tx per vote).
# Higher = fewer txs, lower gas cost. Tune for desired onchain volume.
VOTE_BATCH_SIZE=1

# How often the relayer polls the queue (ms). Default 15000.
VOTE_POLL_INTERVAL=15000

# Celo signing key for the vote relayer. Must have CELO for gas.
# The ARIA agent / prize pool wallet is the default relayer.
CELO_SIGNING_KEY=set-on-server-only
